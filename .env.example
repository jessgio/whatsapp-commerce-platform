# ---------------------------------------------------------------------------
# Merlot Commerce Platform — environment
# Copy to `.env.local`. With NO values set, the app runs in DEMO mode
# (sample data, mocked integrations) so you can explore the full UI instantly.
# ---------------------------------------------------------------------------

# Supabase (database + auth). Setting these switches the app to LIVE mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business Platform (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_CATALOG_ID=
# Required in production: the handshake token has no default outside dev.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=merlot-verify
# Required in live mode: verifies the X-Hub-Signature-256 HMAC on deliveries.
WHATSAPP_APP_SECRET=

# Payments — choose "midtrans" or "xendit"
PAYMENT_PROVIDER=midtrans
PAYMENT_IS_PRODUCTION=false
# Required in live mode when PAYMENT_PROVIDER=midtrans (verifies signature_key).
MIDTRANS_SERVER_KEY=
XENDIT_SECRET_KEY=
# Required in live mode when PAYMENT_PROVIDER=xendit (the x-callback-token header).
XENDIT_CALLBACK_TOKEN=

# 3PL — Biteship (SiCepat, J&T, JNE, Anteraja, ...)
BITESHIP_API_KEY=
# Required in live mode: shared secret for the tracking webhook.
BITESHIP_WEBHOOK_SECRET=
# Optional: fan-out the same payload to the legacy packing app (Biteship allows one URL per event).
BITESHIP_WEBHOOK_FORWARD_URL=
# Copy from the packing app Vercel env so the forwarded POST still authenticates there.
BITESHIP_WEBHOOK_SIGNATURE_KEY=
BITESHIP_WEBHOOK_SIGNATURE_SECRET=
WAREHOUSE_ORIGIN_POSTAL_CODE=12190
WAREHOUSE_ORIGIN_CONTACT_NAME=Warehouse
WAREHOUSE_ORIGIN_CONTACT_PHONE=081234567890
WAREHOUSE_ORIGIN_ADDRESS=Jl. Sudirman No. 1, Jakarta Selatan
# Filled by `npm run biteship:test-orders` for API activation form
BITESHIP_TEST_DELIVERED_ORDER_ID=
BITESHIP_TEST_CANCELLED_ORDER_ID=

# Email (Resend) — lead welcome + campaign batch sends
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_FORM_BASE_URL=

# Cloudflare Turnstile — public /daftar (+ edit) bot check.
# Production keys go here / on Vercel. Local `npm run dev` and localhost
# automatically use Cloudflare dummy keys (always-pass) instead.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional override: true = always dummy, false = always production keys.
# TURNSTILE_USE_TEST_KEYS=

# Vercel Cron — Authorization: Bearer <CRON_SECRET> for /api/cron/campaigns
CRON_SECRET=

# Staff mobile API — allow Authorization: Demo <userId> even when Supabase is
# configured (local Expo Go testing only; never enable in production).
# STAFF_API_ALLOW_DEMO=true

