# Next.js origin that serves /api/staff/* (no trailing slash).
# On a physical phone use your machine's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Same Supabase project as the portal (required for live staff login).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Show demo role picker (pairs with Next STAFF_API_ALLOW_DEMO=true).
# EXPO_PUBLIC_DEMO_LOGIN=true
