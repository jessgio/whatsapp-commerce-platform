# Nest API — copy to `.env` (never commit). Deploy this folder as a second
# Vercel project with Root Directory = apps/api.

PORT=4000
API_SECRET=
CORS_ORIGINS=http://localhost:3000,https://whatsapp.aerisbeaute.com

# Same Supabase project as the Next app (service role stays on the API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (REST). Used as a hot cache so CRM reads are not lola.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How long (seconds) to keep the customer list in Redis.
CUSTOMERS_CACHE_TTL=60
